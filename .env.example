# Copy to .env and fill in. ARCHITECTURE.md §10 is the list of variables; the repository holds
# no secrets, and .env is git-ignored.
#
#     cp .env.example .env
#     docker compose up --build postgres migrate seed api bot

# --- MAX ------------------------------------------------------------------------------------
# Bot token from @MasterBot. Required by the bot; the api never calls MAX (§2) and starts
# without it, but initData cannot be verified without it, so set it for a working mini-app.
MAX_BOT_TOKEN=

# The bot's public name, without "@". It is what deep links are built from:
# https://max.ru/<MAX_BOT_USERNAME>?startapp=ci_<event>_<code> (§5). A deep link cannot be
# built without it, so the placeholder below keeps `docker compose up` working out of the
# box — replace it with the real bot name or every link will point at a bot nobody owns.
MAX_BOT_USERNAME=campus_demo_bot

# Base URL of the MAX Bot API. Change only to point at a mock.
MAX_API_BASE_URL=https://platform-api2.max.ru

# --- database -------------------------------------------------------------------------------
# Inside compose the host is the `postgres` service. Running the backend on the host instead,
# use localhost: postgresql+asyncpg://campus:campus@localhost:5432/campus
DATABASE_URL=postgresql+asyncpg://campus:campus@postgres:5432/campus

# Credentials the postgres container is created with; they must match DATABASE_URL above.
POSTGRES_USER=campus
POSTGRES_PASSWORD=campus
POSTGRES_DB=campus
# Host port the database is published on; change it if 5432 is taken.
POSTGRES_PORT=5432

# --- university ------------------------------------------------------------------------------
# The YAML of §6, validated at start-up; an invalid file stops the process. The image ships the
# example; mount your own file and point this at it for a real institution.
UNIVERSITY_CONFIG_PATH=/app/config/university.example.yaml

# --- people ----------------------------------------------------------------------------------
# MAX user ids that are administrators, comma-separated. Admins mint organizer invitations
# (§7 POST /api/org/invites). Leave empty and use the invitation `python -m campus.seed` prints.
ADMIN_MAX_USER_IDS=

# --- web -------------------------------------------------------------------------------------
# Public origin the mini-app is served from, without a trailing slash, e.g. https://campus.example
PUBLIC_WEB_URL=

# Host port the api is published on; inside compose the mini-app reaches it as api:8000.
API_PORT=8000

# --- check-in codes (§5) ----------------------------------------------------------------------
# How long one rotating code lives, in seconds. Shorter is safer, but harder to type by hand.
CHECKIN_CODE_STEP_SECONDS=10

# How many already-expired windows are still accepted, for the time between reading a QR and
# the request arriving. 2 with a 10-second step means a code is good for up to 30 seconds.
CHECKIN_CODE_TOLERANCE_STEPS=2

# --- mini-app launch data ---------------------------------------------------------------------
# How old an `auth_date` inside X-Max-Init-Data may be, in seconds (§7). 86400 = one day.
INIT_DATA_TTL_SECONDS=86400

# --- logging -----------------------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL. Logs are structured and never contain the token,
# initData, a qr_seed or a check-in code (§11).
LOG_LEVEL=INFO
